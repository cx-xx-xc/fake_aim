{
  "name": "@local/aim-trainer",
  "version": "1.1.0",
  "private": false,
  "description": "Aim trainer floating window for the DeepSeek Harness Web UI: click, reaction and tracking drills with a draggable Aimlabs-style window.",
  "type": "module",
  "license": "MIT",
  "author": "cx_x",
  "keywords": ["dsh-plugin", "deepseek-harness", "aim-trainer", "aimlabs", "fps", "training"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cx-xx-xc/fake_aim.git"
  },
  "homepage": "https://github.com/cx-xx-xc/fake_aim#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
